{
  "name": "@notch/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "notch-agent-runtime": "./dist/daemon.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "import": "./dist/daemon.js",
      "default": "./dist/daemon.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "esbuild src/daemon.ts --bundle --platform=node --format=esm --outfile=dist/daemon.js",
    "start": "node dist/daemon.js",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@notch/shared-types": "workspace:*",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
